# Line endings are fixed here so every clone (and CI) sees the same files,
# whatever the local core.autocrlf setting. .editorconfig asks for CRLF.
* text=auto

*.cs       text eol=crlf
*.xaml     text eol=crlf
*.csproj   text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.sln      text eol=crlf
*.json     text eol=crlf
*.md       text eol=crlf
*.iss      text eol=crlf
*.editorconfig text eol=crlf

# Git hooks and shell scripts run under sh and must use LF.
.husky/*   text eol=lf
*.sh       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf

*.ico binary
*.png binary
