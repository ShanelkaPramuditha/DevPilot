<Window x:Class="DevPilot.Views.Dialogs.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command Palette"
        Width="620"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Brush.Card}"
        BorderBrush="{DynamicResource Brush.CardStroke}"
        BorderThickness="1"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="10">
        <Grid>
            <TextBox x:Name="QueryBox" FontSize="15" Padding="34,7,8,7" VerticalContentAlignment="Center" TextChanged="QueryBox_TextChanged"/>
            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                       Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
            <TextBlock x:Name="QueryHint" Text="Type a command, a page, a distribution or an SSH host..." FontSize="15"
                       Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="36,0,0,0" IsHitTestVisible="False"/>
        </Grid>

        <ListBox
            x:Name="ResultList"
            Margin="0,8,0,0"
            MaxHeight="380"
            BorderThickness="0"
            Background="Transparent"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            MouseUp="ResultList_MouseUp">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="8,6"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" Width="30" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" Foreground="{DynamicResource Brush.TextSecondary}"
                                   FontSize="12" VerticalAlignment="Center" Margin="12,0,4,0"/>
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyText" Text="No matching commands." Foreground="{DynamicResource Brush.TextSecondary}"
                   Margin="10,10,0,4" Visibility="Collapsed"/>
        <TextBlock Text="↑↓ to choose · Enter to run · Esc to close" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                   Margin="4,8,0,0"/>
    </StackPanel>
</Window>
