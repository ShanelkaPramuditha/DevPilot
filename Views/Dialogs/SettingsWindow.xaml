<Window x:Class="DevPilot.Views.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/DevPilot;component/Assets/DevPilot.ico"
        Title="Settings"
        Height="640"
        Width="820"
        MinHeight="420"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style x:Key="Note" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.NoteBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.NoteStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Save bar -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="SaveButton" Content="Save" Margin="0,0,8,0" Click="Save_Click"/>
                <Button x:Name="SaveRestartButton" Content="Save and Restart" FontWeight="SemiBold" Margin="0,0,8,0" Click="SaveRestart_Click"/>
                <Button Content="Close" IsCancel="True"/>
            </StackPanel>
            <ProgressBar
                x:Name="BusyProgress"
                DockPanel.Dock="Right"
                Width="100"
                Height="10"
                Margin="0,0,12,0"
                IsIndeterminate="True"
                Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" Text="Loading..."/>
        </DockPanel>

        <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
            <TabItem x:Name="DistroTab" Header="Distribution">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <Border Style="{StaticResource Note}">
                            <TextBlock x:Name="DistroNote" TextWrapping="Wrap"/>
                        </Border>
                        <StackPanel x:Name="DistroForm"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="GlobalTab" Header="WSL and Resources">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <Border Style="{StaticResource Note}">
                            <TextBlock TextWrapping="Wrap">
                                These settings are saved in <Run FontWeight="SemiBold">%UserProfile%\.wslconfig</Run> and apply to
                                <Run FontWeight="SemiBold">all WSL 2 distributions</Run>, which share one virtual machine.
                                They take effect after WSL shuts down. Leave a value on Default to let WSL decide.
                            </TextBlock>
                        </Border>
                        <StackPanel x:Name="GlobalForm"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="DiskTab" Header="Disk">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel x:Name="DiskPanel">
                        <Border Style="{StaticResource Note}">
                            <TextBlock TextWrapping="Wrap" Text="These actions change the distribution's virtual disk file. The distribution is stopped first. Export a backup before resizing or moving it."/>
                        </Border>

                        <TextBlock Text="Location" FontWeight="SemiBold"/>
                        <DockPanel Margin="0,4,0,16">
                            <Button x:Name="OpenLocationButton" DockPanel.Dock="Right" Content="Open Folder" Margin="8,0,0,0" Click="OpenLocation_Click"/>
                            <TextBox x:Name="LocationBox" IsReadOnly="True" VerticalContentAlignment="Center" Padding="4"/>
                        </DockPanel>

                        <TextBlock Text="Disk file" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DiskSizeText" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,16"/>

                        <TextBlock Text="Sparse disk (give freed space back to Windows)" FontWeight="SemiBold"/>
                        <TextBlock
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            TextWrapping="Wrap"
                            Margin="0,4,0,6"
                            Text="Without it, the disk file keeps its largest size even after files are deleted inside Linux."/>
                        <DockPanel Margin="0,0,0,16">
                            <Button x:Name="SparseButton" DockPanel.Dock="Right" Content="Turn On" Click="Sparse_Click"/>
                            <TextBlock x:Name="SparseStatusText" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Text="Maximum disk size" FontWeight="SemiBold"/>
                        <TextBlock
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            TextWrapping="Wrap"
                            Margin="0,4,0,6"
                            Text="The largest the virtual disk may grow to, for example 256GB. The file only takes the space actually used."/>
                        <DockPanel Margin="0,0,0,16">
                            <Button x:Name="ResizeButton" DockPanel.Dock="Right" Content="Resize" Margin="8,0,0,0" Click="Resize_Click"/>
                            <TextBox x:Name="ResizeBox" VerticalContentAlignment="Center" Padding="4"/>
                        </DockPanel>

                        <TextBlock Text="Move to another folder or drive" FontWeight="SemiBold"/>
                        <DockPanel Margin="0,4,0,16">
                            <Button x:Name="MoveButton" DockPanel.Dock="Right" Content="Move..." Click="Move_Click"/>
                            <TextBlock
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center"
                                Text="Frees space on the current drive, for example by moving the distribution from C: to D:."/>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="FilesTab" Header="Config Files">
                <DockPanel Margin="12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <ComboBox
                            x:Name="FileSelector"
                            DockPanel.Dock="Left"
                            Width="300"
                            Padding="8,4"
                            VerticalContentAlignment="Center"
                            SelectionChanged="FileSelector_SelectionChanged"/>
                        <TextBlock
                            x:Name="FileHint"
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBox
                        x:Name="RawBox"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="13"
                        AcceptsReturn="True"
                        AcceptsTab="True"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        Padding="6"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
