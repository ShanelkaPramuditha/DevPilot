<Window x:Class="DevPilot.Views.Dialogs.SshHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/DevPilot;component/Assets/DevPilot.ico"
        Title="SSH Host"
        Width="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,12,20,18">
        <TextBlock Text="Host" Style="{StaticResource Label}"/>
        <TextBox x:Name="PatternsBox"/>
        <TextBlock Style="{StaticResource Hint}" Text="The name you connect with, as in ssh web-server. Several names or patterns (*.example.com) can be separated by spaces."/>

        <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Address (HostName)" Style="{StaticResource Label}"/>
                <TextBox x:Name="HostNameBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Port" Style="{StaticResource Label}"/>
                <TextBox x:Name="PortBox"/>
            </StackPanel>
        </Grid>
        <TextBlock Style="{StaticResource Hint}" Text="Server name or IP address. Port is usually empty (22)."/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="User" Style="{StaticResource Label}"/>
                <TextBox x:Name="UserBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Jump host (ProxyJump)" Style="{StaticResource Label}"/>
                <TextBox x:Name="ProxyJumpBox"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Key file (IdentityFile)" Style="{StaticResource Label}"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,2" Click="BrowseKey_Click"/>
            <TextBox x:Name="IdentityFileBox"/>
        </DockPanel>
        <TextBlock Style="{StaticResource Hint}" Text="The private key, for example ~/.ssh/id_ed25519. Leave empty to use your default keys or ssh-agent."/>

        <TextBlock Text="Forward SSH agent (ForwardAgent)" Style="{StaticResource Label}"/>
        <ComboBox x:Name="ForwardAgentBox" Width="200" HorizontalAlignment="Left" SelectedIndex="0">
            <ComboBoxItem Content="Default (no)" Tag=""/>
            <ComboBoxItem Content="Yes" Tag="yes"/>
            <ComboBoxItem Content="No" Tag="no"/>
        </ComboBox>
        <TextBlock Style="{StaticResource Hint}" Text="Only turn this on for servers you trust: they can use your keys while you are connected."/>

        <StackPanel x:Name="OtherOptionsPanel" Visibility="Collapsed">
            <TextBlock Text="Other options in this host (kept as they are)" Style="{StaticResource Label}"/>
            <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.CardStroke}" BorderThickness="1" CornerRadius="4" Padding="10,6">
                <TextBlock x:Name="OtherOptionsText" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="SaveButton" Content="Save" IsDefault="True" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Cancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
