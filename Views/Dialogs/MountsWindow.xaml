<Window x:Class="DevPilot.Views.Dialogs.MountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/DevPilot;component/Assets/DevPilot.ico"
        Title="Folder Mounts"
        Height="460"
        Width="900"
        MinHeight="320"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="Padding" Value="2,4"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Title and the actions that do not need a selected mount -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel x:Name="ActionsPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AddButton" Content="Add Mount..." FontWeight="SemiBold" Margin="8,0,8,0" Click="Add_Click"/>
                <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    TextWrapping="Wrap"
                    Text="Mount a Windows folder at a Linux path, for example ~/projects. Whole drives are already available under /mnt/c, /mnt/d and so on."/>
            </StackPanel>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <ProgressBar
                x:Name="BusyProgress"
                DockPanel.Dock="Right"
                Width="120"
                Height="12"
                IsIndeterminate="True"
                Visibility="Hidden"/>
            <TextBlock x:Name="BusyText" Foreground="{DynamicResource Brush.TextSecondary}" Text="Ready" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <TextBlock
            x:Name="HintText"
            DockPanel.Dock="Bottom"
            Foreground="{DynamicResource Brush.TextSecondary}"
            Margin="0,8,0,0"
            Text="Right-click a mount for actions."/>

        <Grid>
            <ListView
                x:Name="MountList"
                SelectionMode="Single"
                SelectionChanged="MountList_SelectionChanged"
                PreviewMouseRightButtonDown="MountList_PreviewMouseRightButtonDown"
                MouseDoubleClick="MountList_MouseDoubleClick">
                <ListView.ContextMenu>
                    <ContextMenu x:Name="MountMenu" Opened="MountMenu_Opened">
                        <MenuItem x:Name="OpenVsCodeItem" Header="Open in _VS Code" Click="OpenVsCode_Click"/>
                        <MenuItem x:Name="OpenTerminalItem" Header="Open _Terminal Here" Click="OpenTerminal_Click"/>
                        <MenuItem x:Name="OpenWindowsItem" Header="Open _Windows Folder" Click="OpenWindows_Click"/>
                        <Separator x:Name="MountSeparator"/>
                        <MenuItem x:Name="MountItem" Header="_Mount" Click="Mount_Click" ToolTip="Mount again using its /etc/fstab entry"/>
                        <MenuItem x:Name="UnmountItem" Header="_Unmount" Click="Unmount_Click" ToolTip="Unmount until the distribution restarts"/>
                        <Separator x:Name="RemoveSeparator"/>
                        <MenuItem x:Name="RemoveItem" Header="_Remove..." Click="Remove_Click" ToolTip="Unmount and remove from /etc/fstab. Windows files are not touched."/>
                        <Separator x:Name="GeneralSeparator"/>
                        <MenuItem x:Name="AddItem" Header="_Add Mount..." Click="Add_Click"/>
                        <MenuItem x:Name="RefreshItem" Header="Re_fresh" Click="Refresh_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Windows folder" Width="280" DisplayMemberBinding="{Binding WindowsPath}"/>
                        <GridViewColumn Header="Linux folder" Width="240" DisplayMemberBinding="{Binding LinuxPath}"/>
                        <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding MountedText}"/>
                        <GridViewColumn Header="Auto-mount" Width="90" DisplayMemberBinding="{Binding PersistentText}"/>
                        <GridViewColumn Header="Access" Width="90" DisplayMemberBinding="{Binding AccessText}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock
                x:Name="Placeholder"
                Text="No Windows folders are mounted in this distribution. Click 'Add Mount...' to add one."
                Foreground="{DynamicResource Brush.TextSecondary}"
                TextWrapping="Wrap"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="24"
                IsHitTestVisible="False"
                Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>
