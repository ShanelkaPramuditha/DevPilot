<Window x:Class="DevPilot.Views.Dialogs.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/DevPilot;component/Assets/DevPilot.ico"
        Title="Update DevPilot"
        Width="640"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,20,22,18">
        <!-- What is available -->
        <DockPanel>
            <Image Width="52" Height="52" Margin="0,0,16,0" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Source>
                    <BitmapImage UriSource="pack://application:,,,/DevPilot;component/Assets/DevPilot.png" DecodePixelWidth="104"/>
                </Image.Source>
            </Image>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"/>
                    <Border
                        x:Name="PreReleaseBadge"
                        Margin="10,0,0,0"
                        Padding="8,2"
                        CornerRadius="4"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Badge.Available}"
                        Visibility="Collapsed">
                        <TextBlock Text="Pre-release" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Badge.AvailableText}"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Release notes -->
        <TextBlock Text="What's new" FontWeight="SemiBold" Margin="0,18,0,6"/>
        <Border
            Background="{DynamicResource Brush.Card}"
            BorderBrush="{DynamicResource Brush.CardStroke}"
            BorderThickness="1"
            CornerRadius="6">
            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Padding="14,10">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" LineHeight="20"/>
            </ScrollViewer>
        </Border>

        <!-- Download progress -->
        <StackPanel x:Name="ProgressPanel" Margin="0,14,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="DownloadProgress" Height="6" Maximum="100"/>
            <TextBlock x:Name="ProgressText" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Portable copies cannot be updated by the setup -->
        <TextBlock
            x:Name="PortableNote"
            Margin="0,14,0,0"
            TextWrapping="Wrap"
            Foreground="{DynamicResource Brush.TextSecondary}"
            Visibility="Collapsed"
            Text="This copy of DevPilot was not installed with the setup (portable or development build), so it cannot update itself. Download the new version from GitHub instead."/>

        <!-- Options -->
        <StackPanel Margin="0,16,0,0">
            <CheckBox x:Name="AutoCheckBox" Content="Check for updates automatically when DevPilot starts"/>
            <CheckBox x:Name="PreReleaseBox" Content="Include pre-releases (beta versions and release candidates)" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Actions -->
        <DockPanel Margin="0,20,0,0">
            <Button x:Name="SkipButton" DockPanel.Dock="Left" Content="Skip This Version" Click="Skip_Click"
                    ToolTip="Don't remind me about this version again"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="GitHubButton" Content="View on GitHub" Margin="0,0,8,0" Click="ViewOnGitHub_Click"/>
                <Button x:Name="LaterButton" Content="Later" IsCancel="True" Margin="0,0,8,0" Click="Later_Click"/>
                <Button x:Name="UpdateButton" Content="Update Now" Style="{StaticResource AccentButton}" IsDefault="True" Click="Update_Click"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
