<Window x:Class="DevPilot.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DevPilot.Views"
        xmlns:controls="clr-namespace:DevPilot.Controls"
        xmlns:nav="clr-namespace:DevPilot.Navigation"
        mc:Ignorable="d"
        Title="DevPilot"
        Icon="pack://application:,,,/DevPilot;component/Assets/DevPilot.ico"
        Height="720"
        Width="1280"
        MinHeight="450"
        MinWidth="820"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- Styles are based on the Fluent theme styles so they follow light/dark mode. -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>

        <!-- Square button for an icon. The icon font is set on the glyph only:
             a font set on the button would also be inherited by its menu. -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Shows only the selected page; the sidebar replaces the tab headers. -->
        <Style x:Key="PageHost" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NavIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="RightAligned" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Status shown as a coloured label -->
        <DataTemplate x:Key="StatusCell">
            <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Status}" FontWeight="SemiBold"/>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.Badge.Available}"/>
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Badge.AvailableText}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Installed">
                                <Setter Property="Background" Value="{DynamicResource Brush.Badge.Installed}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Badge.InstalledText}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                <Setter Property="Background" Value="{DynamicResource Brush.Badge.Running}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Badge.RunningText}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Not for this PC">
                                <Setter Property="Background" Value="{DynamicResource Brush.Badge.Disabled}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Badge.DisabledText}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>

        <!-- State with a dot: green while running -->
        <DataTemplate x:Key="StateCell">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding State}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DownloadCell">
            <TextBlock Text="{Binding DownloadSizeText}" Style="{StaticResource RightAligned}"/>
        </DataTemplate>

        <DataTemplate x:Key="DiskSizeCell">
            <TextBlock Text="{Binding DiskSizeText}" Style="{StaticResource RightAligned}"/>
        </DataTemplate>

        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: built from the pages (TabItems) below -->
        <Border
            x:Name="Sidebar"
            Grid.Column="0"
            Width="232"
            Background="{DynamicResource Brush.Sidebar}"
            BorderBrush="{DynamicResource Brush.CardStroke}"
            BorderThickness="0,0,1,0">
            <DockPanel Margin="6,8,6,10">
                <!-- Menu toggle and app name -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button
                        x:Name="SidebarToggle"
                        Style="{StaticResource NavIconButton}"
                        ToolTip="Collapse menu"
                        AutomationProperties.Name="Toggle menu"
                        Click="SidebarToggle_Click">
                        <TextBlock Text="&#xE700;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/>
                    </Button>
                    <StackPanel
                        Orientation="Horizontal"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=local:MainWindow}, Converter={StaticResource BoolToVisibility}}">
                        <Image
                            Width="24"
                            Height="24"
                            RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Source>
                                <!-- Decoded at twice the display size (sharp on high-DPI screens) instead of the full 512 px -->
                                <BitmapImage UriSource="pack://application:,,,/DevPilot;component/Assets/DevPilot.png" DecodePixelWidth="48"/>
                            </Image.Source>
                        </Image>
                        <TextBlock
                            Text="DevPilot"
                            FontSize="15"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Shared settings and WSL status -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Button
                        x:Name="NavSettingsButton"
                        Style="{StaticResource NavButton}"
                        ToolTip="WSL Settings: resource limits, networking and more"
                        Click="WslSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource NavGlyph}"/>
                            <TextBlock
                                Text="WSL Settings"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=local:MainWindow}, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Button>

                    <Border
                        x:Name="StatusCard"
                        Margin="2,8,2,0"
                        Padding="10,8"
                        CornerRadius="6"
                        Background="{DynamicResource Brush.Card}"
                        BorderBrush="{DynamicResource Brush.CardStroke}"
                        BorderThickness="1"
                        ToolTip="{Binding Text, ElementName=WslDetailsText}">
                        <DockPanel>
                            <Ellipse
                                x:Name="StatusDot"
                                DockPanel.Dock="Left"
                                Width="10"
                                Height="10"
                                Margin="3,4,0,0"
                                VerticalAlignment="Top"
                                Fill="{DynamicResource Brush.TextMuted}"/>
                            <StackPanel
                                Margin="10,0,0,0"
                                Visibility="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=local:MainWindow}, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock x:Name="WslStatusText" Text="Checking WSL..." FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="WslDetailsText" Style="{StaticResource HintText}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Pages, grouped -->
                <ListBox
                    x:Name="NavList"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectionChanged="NavList_SelectionChanged">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,10,4,4">
                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Brush.TextMuted}"
                                            Visibility="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=local:MainWindow}, Converter={StaticResource BoolToVisibility}}"/>
                                        <Border
                                            Height="1"
                                            Background="{DynamicResource Brush.CardStroke}"
                                            Visibility="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=local:MainWindow}, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="ToolTip" Value="{Binding Tab.Header}"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                                            <Grid>
                                                <Border
                                                    x:Name="Pill"
                                                    Width="3"
                                                    Height="16"
                                                    CornerRadius="1.5"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource Brush.Accent}"
                                                    Visibility="Collapsed"/>
                                                <ContentPresenter/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.NavSelected}"/>
                                                <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                                                <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Tab.(nav:PageInfo.Glyph)}" Style="{StaticResource NavGlyph}"/>
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Tab.Header}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=local:MainWindow}, Converter={StaticResource BoolToVisibility}}"/>
                                <Border
                                    Grid.Column="2"
                                    Margin="6,0,8,0"
                                    Padding="7,1"
                                    CornerRadius="9"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.Badge.Available}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=local:MainWindow}, Converter={StaticResource BoolToVisibility}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tab.(nav:PageInfo.Badge)}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Tab.(nav:PageInfo.Badge)}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Badge.AvailableText}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page area -->
        <Grid Grid.Column="1" Margin="24,14,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Shown when a newer DevPilot is available (Views/MainWindow.Updates.cs) -->
            <Border
                x:Name="UpdateBanner"
                Grid.Row="1"
                Margin="0,0,0,14"
                Padding="14,10"
                CornerRadius="6"
                Background="{DynamicResource Brush.NoteBackground}"
                BorderBrush="{DynamicResource Brush.NoteStroke}"
                BorderThickness="1"
                Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="See What's New" Style="{StaticResource AccentButton}" Margin="12,0,8,0" Click="UpdateBannerOpen_Click"/>
                        <Button Style="{StaticResource NavIconButton}" Width="32" Height="32" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" Click="UpdateBannerDismiss_Click">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <!-- Page title and the "more" menu -->
            <DockPanel x:Name="HeaderPanel" Grid.Row="0" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button
                    x:Name="InstallWslButton"
                    Style="{StaticResource AccentButton}"
                    Content="Install WSL"
                    Visibility="Collapsed"
                    Click="InstallWsl_Click"/>
                <Button
                    x:Name="PaletteButton"
                    Style="{StaticResource IconButton}"
                    ToolTip="Search commands (Ctrl+K)"
                    AutomationProperties.Name="Search commands"
                    Click="CommandPalette_Click">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/>
                </Button>
                <Button
                    x:Name="MoreButton"
                    Style="{StaticResource IconButton}"
                    ToolTip="More options"
                    AutomationProperties.Name="More options"
                    Click="More_Click">
                    <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MoreMenu" Placement="Bottom" Opened="MoreMenu_Opened">
                            <MenuItem Header="_Refresh" InputGestureText="F5" Click="Refresh_Click"/>
                            <Separator/>
                            <MenuItem x:Name="WslSettingsItem" Header="WSL _Settings..." Click="WslSettings_Click"
                                      ToolTip="Resource limits, networking and other settings shared by all distributions"/>
                            <MenuItem x:Name="UpdateWslItem" Header="_Update WSL..." Click="UpdateWsl_Click"/>
                            <MenuItem x:Name="ShutdownWslItem" Header="Shut _Down WSL..." Click="ShutdownWsl_Click"/>
                            <Separator/>
                            <MenuItem x:Name="CloseToTrayItem" Header="Keep Running in _Notification Area" IsCheckable="True" Click="CloseToTray_Click"
                                      ToolTip="Closing the window keeps DevPilot in the notification area, with quick access to your distributions"/>
                            <MenuItem x:Name="StartWithWindowsItem" Header="Start with _Windows" IsCheckable="True" Click="StartWithWindows_Click"/>
                            <Separator/>
                            <MenuItem Header="_Theme">
                                <MenuItem x:Name="ThemeSystemItem" Header="Use _Windows setting" IsCheckable="True" Tag="System" Click="Theme_Click"/>
                                <MenuItem x:Name="ThemeLightItem" Header="_Light" IsCheckable="True" Tag="Light" Click="Theme_Click"/>
                                <MenuItem x:Name="ThemeDarkItem" Header="_Dark" IsCheckable="True" Tag="Dark" Click="Theme_Click"/>
                            </MenuItem>
                            <MenuItem Header="_Keyboard Shortcuts" Click="Shortcuts_Click"/>
                            <Separator/>
                            <MenuItem Header="Check for _Updates..." Click="CheckForUpdates_Click"/>
                            <MenuItem Header="_About DevPilot" Click="About_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        x:Name="PageTitleText"
                        Text="{Binding SelectedItem.Header, ElementName=DistroTabs}"
                        FontSize="24"
                        FontWeight="SemiBold"/>
                    <TextBlock
                        x:Name="PageSubtitleText"
                        Text="{Binding SelectedItem.(nav:PageInfo.Subtitle), ElementName=DistroTabs}"
                        Style="{StaticResource HintText}"
                        Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <TabControl x:Name="DistroTabs" Grid.Row="2" Style="{StaticResource PageHost}" SelectionChanged="DistroTabs_SelectionChanged">
                <!-- Pages: each TabItem is one sidebar entry (see Page.cs) -->
                <TabItem x:Name="InstalledTab" Header="Installed"
                         nav:PageInfo.Glyph="&#xE756;"
                         nav:PageInfo.Group="WSL"
                         nav:PageInfo.Subtitle="Linux distributions on this PC. Right-click one for actions, double-click to open a terminal.">
                    <DockPanel Margin="0,4,0,0">
                        <Grid>
                            <ListView
                                x:Name="InstalledList"
                                SelectionMode="Single"
                                GridViewColumnHeader.Click="ListHeader_Click"
                                SelectionChanged="InstalledList_SelectionChanged"
                                PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown"
                                MouseDoubleClick="InstalledList_MouseDoubleClick">
                                <ListView.ContextMenu>
                                    <ContextMenu x:Name="InstalledMenu" Opened="InstalledMenu_Opened">
                                        <MenuItem x:Name="OpenTerminalItem" Header="Open _Terminal" FontWeight="SemiBold" Click="OpenTerminal_Click"/>
                                        <MenuItem x:Name="OpenVsCodeItem" Header="Open in _VS Code" Click="OpenVsCode_Click"/>
                                        <MenuItem x:Name="OpenFilesItem" Header="Open _Files" Click="OpenFiles_Click"/>
                                        <MenuItem x:Name="FolderMountsItem" Header="Folder _Mounts..." Click="FolderMounts_Click"/>
                                        <MenuItem x:Name="SettingsItem" Header="Se_ttings..." Click="DistroSettings_Click"/>
                                        <Separator x:Name="LifecycleSeparator"/>
                                        <MenuItem x:Name="StartDistroItem" Header="_Start" Click="StartDistro_Click"/>
                                        <MenuItem x:Name="RestartDistroItem" Header="_Restart" Click="RestartDistro_Click"/>
                                        <MenuItem x:Name="StopDistroItem" Header="St_op" Click="StopDistro_Click"/>
                                        <Separator x:Name="SettingsSeparator"/>
                                        <MenuItem x:Name="SetDefaultItem" Header="Set as _Default" Click="SetDefault_Click"/>
                                        <MenuItem x:Name="ConvertVersionItem" Header="Convert to WSL 2" Click="ConvertVersion_Click"/>
                                        <Separator x:Name="BackupSeparator"/>
                                        <MenuItem x:Name="CloneItem" Header="_Clone..." Click="Clone_Click"
                                                  ToolTip="Make a copy of this distribution under a new name"/>
                                        <MenuItem x:Name="ExportItem" Header="_Export..." Click="Export_Click"/>
                                        <MenuItem x:Name="ImportItem" Header="_Import..." Click="Import_Click"/>
                                        <Separator x:Name="UnregisterSeparator"/>
                                        <MenuItem x:Name="UnregisterItem" Header="_Unregister..." Click="Unregister_Click"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="80" DisplayMemberBinding="{Binding DefaultMark}">
                                            <GridViewColumnHeader Content="Default" Tag="IsDefault" ToolTip="The distribution started by plain 'wsl'"/>
                                        </GridViewColumn>
                                        <GridViewColumn Width="220" DisplayMemberBinding="{Binding Name}">
                                            <GridViewColumnHeader Content="Name" Tag="Name"/>
                                        </GridViewColumn>
                                        <GridViewColumn Width="100" CellTemplate="{StaticResource StateCell}">
                                            <GridViewColumnHeader Content="State" Tag="State"/>
                                        </GridViewColumn>
                                        <GridViewColumn Width="115" DisplayMemberBinding="{Binding Version}">
                                            <GridViewColumnHeader Content="WSL Version" Tag="Version"/>
                                        </GridViewColumn>
                                        <GridViewColumn Width="100" CellTemplate="{StaticResource DiskSizeCell}">
                                            <GridViewColumnHeader Content="Disk size" Tag="DiskBytes" ToolTip="Measured size of the distribution's virtual disk"/>
                                        </GridViewColumn>
                                        <GridViewColumn Width="460" DisplayMemberBinding="{Binding Location}">
                                            <GridViewColumnHeader Content="Location" Tag="Location"/>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock
                                x:Name="InstalledPlaceholder"
                                Text="No distributions installed yet. Open the 'Available' tab to install one, or right-click here to import a backup."
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                TextWrapping="Wrap"
                                TextAlignment="Center"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="24"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"/>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <TabItem x:Name="AvailableTab" Header="Available"
                         nav:PageInfo.Glyph="&#xE896;"
                         nav:PageInfo.Group="WSL"
                         nav:PageInfo.Subtitle="Distributions you can install from the WSL catalog.">
                    <DockPanel Margin="8">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button
                                x:Name="InstallDistroButton"
                                DockPanel.Dock="Right"
                                Content="Install"
                                Margin="8,0,0,0"
                                Click="InstallDistro_Click"/>
                            <Grid>
                                <TextBox
                                    x:Name="SearchBox"
                                    Padding="6,5"
                                    VerticalContentAlignment="Center"
                                    TextChanged="SearchBox_TextChanged"/>
                                <TextBlock
                                    x:Name="SearchHint"
                                    Text="Search by name, publisher or version..."
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"/>
                            </Grid>
                        </DockPanel>

                        <TextBlock
                            x:Name="CatalogFootnote"
                            DockPanel.Dock="Bottom"
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            Margin="0,8,0,0"
                            TextWrapping="Wrap"
                            Text="Click a column header to sort, double-click a row to install."/>

                        <Grid>
                            <ListView
                                x:Name="OnlineList"
                                SelectionMode="Single"
                                GridViewColumnHeader.Click="ListHeader_Click"
                                SelectionChanged="OnlineList_SelectionChanged"
                                PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown"
                                MouseDoubleClick="OnlineList_MouseDoubleClick">
                                <ListView.ContextMenu>
                                    <ContextMenu x:Name="OnlineMenu" Opened="OnlineMenu_Opened">
                                        <MenuItem x:Name="InstallDistroItem" Header="_Install" FontWeight="SemiBold" Click="InstallDistro_Click"/>
                                        <MenuItem x:Name="ShowInstalledItem" Header="Show in _Installed tab" Click="ShowInstalled_Click"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="235" DisplayMemberBinding="{Binding DisplayName}">
                                            <GridViewColumnHeader Content="Name" Tag="FriendlyName" ToolTip="From the WSL catalog"/>
                                        </GridViewColumn>
                                        <GridViewColumn Width="90" DisplayMemberBinding="{Binding Version}">
                                            <GridViewColumnHeader Content="Version" Tag="Version" ToolTip="From the catalog name or image file"/>
                                        </GridViewColumn>
                                        <GridViewColumn Width="145" DisplayMemberBinding="{Binding Publisher}">
                                            <GridViewColumnHeader Content="Publisher" Tag="Publisher"/>
                                        </GridViewColumn>
                                        <GridViewColumn Width="115" DisplayMemberBinding="{Binding Architecture}">
                                            <GridViewColumnHeader Content="Architecture" Tag="Architecture" ToolTip="Processor architectures the catalog provides images for"/>
                                        </GridViewColumn>
                                        <GridViewColumn Width="90" CellTemplate="{StaticResource DownloadCell}">
                                            <GridViewColumnHeader Content="Download" Tag="DownloadBytes" ToolTip="Size of the image for this PC, read from the download server"/>
                                        </GridViewColumn>
                                        <GridViewColumn Width="110" DisplayMemberBinding="{Binding DefaultRam}">
                                            <GridViewColumnHeader Content="Default RAM" Tag="DefaultRam" ToolTip="Memory limit of the WSL 2 VM, shared by all running distributions"/>
                                        </GridViewColumn>
                                        <GridViewColumn Width="115" CellTemplate="{StaticResource StatusCell}">
                                            <GridViewColumnHeader Content="Status" Tag="Status"/>
                                        </GridViewColumn>
                                        <GridViewColumn Width="110" DisplayMemberBinding="{Binding Support}">
                                            <GridViewColumnHeader Content="Support" Tag="Support" ToolTip="Release model of the distribution"/>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock
                                x:Name="OnlinePlaceholder"
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                TextWrapping="Wrap"
                                TextAlignment="Center"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="24"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"/>
                        </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="UsageTab" Header="Usage"
                         nav:PageInfo.Glyph="&#xE9D9;"
                         nav:PageInfo.Group="WSL"
                         nav:PageInfo.Subtitle="Live CPU, memory and disk use of WSL and each distribution.">
                    <DockPanel Margin="8,8,0,0">
                        <!-- Toolbar: what is measured, when, and refresh controls -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,8,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox
                                    x:Name="AutoRefreshBox"
                                    Content="Auto refresh every"
                                    IsChecked="True"
                                    VerticalAlignment="Center"
                                    Checked="AutoRefresh_Changed"
                                    Unchecked="AutoRefresh_Changed"/>
                                <ComboBox
                                    x:Name="RefreshIntervalBox"
                                    Width="100"
                                    Margin="6,0,10,0"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Height="{Binding ActualHeight, ElementName=RefreshUsageButton}"
                                    SelectedIndex="1"
                                    SelectionChanged="RefreshInterval_Changed">
                                    <ComboBoxItem Content="2 sec" Tag="2"/>
                                    <ComboBoxItem Content="5 sec" Tag="5"/>
                                    <ComboBoxItem Content="10 sec" Tag="10"/>
                                    <ComboBoxItem Content="30 sec" Tag="30"/>
                                </ComboBox>
                                <Button
                                    x:Name="RefreshUsageButton"
                                    Content="Refresh Now"
                                    Margin="0"
                                    Click="RefreshUsage_Click"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="UsageTitleText" Text="WSL 2 virtual machine" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="UsageUpdatedText" Style="{StaticResource HintText}" Text="Not updated yet"/>
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer x:Name="UsageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,8,12">
                                <!-- Health: plain-language findings with one-click fixes -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Health" Style="{StaticResource CardTitle}"/>
                                        <StackPanel x:Name="InsightsPanel"/>
                                    </StackPanel>
                                </Border>

                                <!-- Key figures -->
                                <UniformGrid Columns="4" Margin="0,0,-10,0">
                                    <controls:StatTile x:Name="CpuTile" Label="CPU"/>
                                    <controls:StatTile x:Name="MemoryTile" Label="Memory in use"/>
                                    <controls:StatTile x:Name="SwapTile" Label="Swap"/>
                                    <controls:StatTile x:Name="UptimeTile" Label="Uptime"/>
                                </UniformGrid>

                                <!-- History -->
                                <UniformGrid Columns="2" Margin="0,0,-10,0">
                                    <controls:HistoryChart x:Name="CpuChart" Title="CPU use" Margin="0,0,10,10"/>
                                    <controls:HistoryChart x:Name="MemoryChart" Title="Memory in use" Margin="0,0,10,10"/>
                                </UniformGrid>

                                <!-- Memory breakdown -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <Button
                                                x:Name="FreeCacheButton"
                                                DockPanel.Dock="Right"
                                                Content="Free Cached Memory"
                                                Margin="0"
                                                ToolTip="Ask Linux to drop its file cache so the memory can go back to Windows"
                                                Click="FreeCache_Click"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Where the memory goes" Style="{StaticResource CardTitle}" Margin="0"/>
                                                <TextBlock x:Name="MemoryLimitText" Style="{StaticResource HintText}"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Stacked bar: segments separated by a 2px gap -->
                                        <Grid x:Name="MemoryBar" Height="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="ProgramsColumn" Width="0*"/>
                                                <ColumnDefinition x:Name="CacheColumn" Width="0*"/>
                                                <ColumnDefinition x:Name="FreeColumn" Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="ProgramsSegment" Grid.Column="0" Background="{DynamicResource Brush.Accent}" CornerRadius="4,0,0,4" Margin="0,0,1,0"/>
                                            <Border x:Name="CacheSegment" Grid.Column="1" Background="{DynamicResource Brush.Series2}" Margin="1,0,1,0"/>
                                            <Border x:Name="FreeSegment" Grid.Column="2" Background="{DynamicResource Brush.AccentTrack}" CornerRadius="0,4,4,0" Margin="1,0,0,0"/>
                                        </Grid>

                                        <!-- Legend: swatch, name, value -->
                                        <WrapPanel Margin="0,10,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                                                <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Brush.Accent}" Margin="0,0,6,0"/>
                                                <TextBlock Text="Programs " Style="{StaticResource HintText}"/>
                                                <TextBlock x:Name="ProgramsText" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                                                <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Brush.Series2}" Margin="0,0,6,0"/>
                                                <TextBlock Text="Cache " Style="{StaticResource HintText}"/>
                                                <TextBlock x:Name="CacheText" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                                                <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Brush.AccentTrack}" Margin="0,0,6,0"/>
                                                <TextBlock Text="Free " Style="{StaticResource HintText}"/>
                                                <TextBlock x:Name="FreeText" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock x:Name="MemoryExplainText" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                                    <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Distributions" Style="{StaticResource CardTitle}" Margin="0"/>
                                        <TextBlock x:Name="DistrosSummaryText" Style="{StaticResource HintText}" Margin="0,0,0,8"/>
                                        <ListView
                                            x:Name="UsageList"
                                            SelectionMode="Single"
                                            PreviewMouseWheel="NestedList_PreviewMouseWheel"
                                            SelectionChanged="UsageList_SelectionChanged"
                                            GridViewColumnHeader.Click="ListHeader_Click">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Width="200" DisplayMemberBinding="{Binding Name}">
                                                        <GridViewColumnHeader Content="Distribution" Tag="Name"/>
                                                    </GridViewColumn>
                                                    <GridViewColumn Width="110" CellTemplate="{StaticResource StateCell}">
                                                        <GridViewColumnHeader Content="State" Tag="State"/>
                                                    </GridViewColumn>
                                                    <GridViewColumn Width="100">
                                                        <GridViewColumnHeader Content="Processes" Tag="Processes"/>
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding ProcessesText}" Style="{StaticResource RightAligned}"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Width="190">
                                                        <GridViewColumnHeader Content="Memory" Tag="MemoryBytes" ToolTip="Resident memory of the processes in this distribution, and its share of the VM"/>
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding MemoryText}" Margin="8,0,0,0" MinWidth="64" TextAlignment="Right"/>
                                                                    <ProgressBar Value="{Binding MemoryShare, Mode=OneWay}" Maximum="100" Height="6" MinHeight="6"
                                                                                 Background="{DynamicResource Brush.AccentTrack}" Foreground="{DynamicResource Brush.Accent}" BorderThickness="0"/>
                                                                </DockPanel>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Width="280">
                                                        <GridViewColumnHeader Content="Disk space" Tag="DiskPercent" ToolTip="Space used inside the distribution and the space it can still use. The virtual disk grows as needed, so free space is limited by the Windows drive that holds it."/>
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <DockPanel ToolTip="{Binding DiskTooltip}" Background="Transparent">
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DiskText}" Margin="8,0,0,0" MinWidth="170"/>
                                                                    <ProgressBar Value="{Binding DiskPercent, Mode=OneWay}" Maximum="100" Height="6" MinHeight="6"
                                                                                 Background="{DynamicResource Brush.AccentTrack}" Foreground="{DynamicResource Brush.Accent}" BorderThickness="0">
                                                                        <ProgressBar.Style>
                                                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasDiskUsage}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </ProgressBar.Style>
                                                                    </ProgressBar>
                                                                </DockPanel>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Width="100">
                                                        <GridViewColumnHeader Content="Disk file" Tag="Distro.DiskBytes" ToolTip="Size of the virtual disk file on Windows"/>
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding DiskFileText}" Style="{StaticResource RightAligned}"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </StackPanel>
                                </Border>

                                <!-- Inside the selected distribution -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock x:Name="DetailsTitle" Text="Inside the distribution" Style="{StaticResource CardTitle}" Margin="0"/>
                                        <TextBlock x:Name="DetailsHint" Style="{StaticResource HintText}" Margin="0,0,0,8" Text="Select a running distribution above."/>
                                        <Grid x:Name="DetailsGrid">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Top processes by memory" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <ListView x:Name="ProcessList" PreviewMouseWheel="NestedList_PreviewMouseWheel">
                                                    <ListView.View>
                                                        <GridView>
                                                            <GridViewColumn Header="Process" Width="160" DisplayMemberBinding="{Binding Name}"/>
                                                            <GridViewColumn Header="PID" Width="70" DisplayMemberBinding="{Binding Pid}"/>
                                                            <GridViewColumn Width="95">
                                                                <GridViewColumnHeader Content="Memory"/>
                                                                <GridViewColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding MemoryText}" Style="{StaticResource RightAligned}"/>
                                                                    </DataTemplate>
                                                                </GridViewColumn.CellTemplate>
                                                            </GridViewColumn>
                                                            <GridViewColumn Width="90">
                                                                <GridViewColumnHeader Content="Avg CPU" ToolTip="Average CPU use since the process started"/>
                                                                <GridViewColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding CpuText}" Style="{StaticResource RightAligned}"/>
                                                                    </DataTemplate>
                                                                </GridViewColumn.CellTemplate>
                                                            </GridViewColumn>
                                                        </GridView>
                                                    </ListView.View>
                                                </ListView>
                                                <TextBlock x:Name="ProcessEmptyText" Style="{StaticResource HintText}" Visibility="Collapsed"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Listening ports" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <ListView x:Name="PortList" PreviewMouseWheel="NestedList_PreviewMouseWheel">
                                                    <ListView.View>
                                                        <GridView>
                                                            <GridViewColumn Header="Port" Width="70" DisplayMemberBinding="{Binding Port}"/>
                                                            <GridViewColumn Header="Type" Width="60" DisplayMemberBinding="{Binding Protocol}"/>
                                                            <GridViewColumn Header="Address" Width="130" DisplayMemberBinding="{Binding AddressText}"/>
                                                            <GridViewColumn Header="Process" Width="170" DisplayMemberBinding="{Binding ProcessText}"/>
                                                            <GridViewColumn Width="70">
                                                                <GridViewColumnHeader Content="" ToolTip="Open web servers at localhost from Windows"/>
                                                                <GridViewColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock ToolTip="{Binding AddressText}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding CanOpenInBrowser}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                            <Hyperlink Tag="{Binding Url}" Click="OpenPort_Click">Open</Hyperlink>
                                                                        </TextBlock>
                                                                    </DataTemplate>
                                                                </GridViewColumn.CellTemplate>
                                                            </GridViewColumn>
                                                        </GridView>
                                                    </ListView.View>
                                                </ListView>
                                                <TextBlock x:Name="PortEmptyText" Style="{StaticResource HintText}" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="ToolsTab" Header="Dev Tools"
                         nav:PageInfo.Glyph="&#xE90F;"
                         nav:PageInfo.Group="Tools"
                         nav:PageInfo.Subtitle="Install, update and remove developer tools on Windows or inside a WSL distribution.">
                    <DockPanel Margin="0,4,0,0">
                        <!-- Where tools are installed -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10">
                            <DockPanel>
                                <Button x:Name="ToolsRefreshButton" DockPanel.Dock="Right" Content="Refresh" Margin="8,0,0,0" Click="ToolsRefresh_Click"/>
                                <TextBlock Text="Install on" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox
                                    x:Name="ToolTargetBox"
                                    Width="240"
                                    VerticalAlignment="Center"
                                    SelectionChanged="ToolTarget_Changed"/>
                                <TextBlock x:Name="ToolTargetHint" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="14,0,0,0"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </DockPanel>
                        </Border>

                        <!-- Output of the running (or last) operation -->
                        <Border x:Name="ToolOutputPanel" DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,10" Visibility="Collapsed">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="ToolCancelButton" Content="Cancel" Margin="8,0,8,0" Click="ToolCancel_Click"/>
                                        <Button x:Name="ToolHideOutputButton" Content="Hide" Margin="0" Click="ToolHideOutput_Click"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="ToolProgress" DockPanel.Dock="Left" Width="90" Height="6" IsIndeterminate="True" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ToolOperationText" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBox
                                    x:Name="ToolOutputBox"
                                    Height="170"
                                    IsReadOnly="True"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="12"
                                    TextWrapping="NoWrap"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Auto"/>
                            </DockPanel>
                        </Border>

                        <Grid>
                            <ListView
                                x:Name="ToolList"
                                SelectionMode="Single"
                                PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown">
                                <ListView.ContextMenu>
                                    <ContextMenu x:Name="ToolMenu" Opened="ToolMenu_Opened">
                                        <MenuItem x:Name="ToolInstallItem" Header="_Install" FontWeight="SemiBold" Click="ToolInstall_Click"/>
                                        <MenuItem x:Name="ToolUpdateItem" Header="_Update" Click="ToolUpdate_Click"/>
                                        <MenuItem x:Name="ToolUninstallItem" Header="U_ninstall..." Click="ToolUninstall_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="ToolWebsiteItem" Header="Open _Website" Click="ToolWebsite_Click"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="360">
                                            <GridViewColumnHeader Content="Tool"/>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,2" ToolTip="{Binding Tooltip}">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Brush.TextSecondary}"
                                                                   TextTrimming="CharacterEllipsis" FontSize="12"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="130" DisplayMemberBinding="{Binding VersionText}">
                                            <GridViewColumnHeader Content="Version"/>
                                        </GridViewColumn>
                                        <GridViewColumn Width="150">
                                            <GridViewColumnHeader Content="Status"/>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" ToolTip="{Binding Tooltip}">
                                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold"/>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.Badge.Disabled}"/>
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Badge.DisabledText}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Installed">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.Badge.Installed}"/>
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Badge.InstalledText}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Update available">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.Badge.Available}"/>
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Badge.AvailableText}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Not installed">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="190">
                                            <GridViewColumnHeader Content=""/>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding ActionText}" Tag="{Binding}" MinWidth="150" Padding="12,4" Margin="0"
                                                            IsEnabled="{Binding CanAct}" ToolTip="{Binding Tooltip}" Click="ToolAction_Click"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock
                                x:Name="ToolPlaceholder"
                                Style="{StaticResource HintText}"
                                TextAlignment="Center"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="460"
                                Margin="24"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"/>
                        </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="SshTab" Header="SSH"
                         nav:PageInfo.Glyph="&#xE8D7;"
                         nav:PageInfo.Group="Tools"
                         nav:PageInfo.Subtitle="Hosts in your SSH config. Right-click a host for actions, double-click to connect.">
                    <DockPanel Margin="0,4,0,0">
                        <!-- Which config file is managed -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="SshOpenFileButton" Content="Open in Editor" Margin="8,0,8,0" Click="SshOpenFile_Click"
                                            ToolTip="Open the config file in your default text editor"/>
                                    <Button x:Name="SshDefaultButton" Content="Use Default" Margin="0,0,8,0" Click="SshUseDefault_Click"
                                            Visibility="Collapsed" ToolTip="Go back to %UserProfile%\.ssh\config"/>
                                    <Button Content="Change File..." Margin="0" Click="SshChangeFile_Click"
                                            ToolTip="Manage a different SSH config file"/>
                                </StackPanel>
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="SshPathText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="SshPathHint" Style="{StaticResource HintText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Search and add -->
                        <DockPanel x:Name="SshToolbar" DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button
                                DockPanel.Dock="Right"
                                Content="Add Host"
                                Style="{StaticResource AccentButton}"
                                Margin="8,0,0,0"
                                Click="SshAddHost_Click"/>
                            <Grid>
                                <TextBox
                                    x:Name="SshSearchBox"
                                    Padding="6,5"
                                    VerticalContentAlignment="Center"
                                    TextChanged="SshSearchBox_TextChanged"/>
                                <TextBlock
                                    x:Name="SshSearchHint"
                                    Text="Search by host, address or user..."
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"/>
                            </Grid>
                        </DockPanel>

                        <TextBlock
                            x:Name="SshStatusText"
                            DockPanel.Dock="Bottom"
                            Margin="0,8,0,0"
                            Style="{StaticResource HintText}"/>

                        <Grid>
                            <ListView
                                x:Name="SshHostList"
                                SelectionMode="Single"
                                GridViewColumnHeader.Click="ListHeader_Click"
                                PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown"
                                MouseDoubleClick="SshHostList_MouseDoubleClick">
                                <ListView.ContextMenu>
                                    <ContextMenu x:Name="SshMenu" Opened="SshMenu_Opened">
                                        <MenuItem x:Name="SshConnectItem" Header="_Connect" FontWeight="SemiBold" Click="SshConnect_Click"/>
                                        <MenuItem x:Name="SshTestItem" Header="_Test Connection" Click="SshTest_Click"
                                                  ToolTip="Try to log in with your keys, without a password prompt"/>
                                        <MenuItem x:Name="SshCopyItem" Header="Copy SSH _Command" Click="SshCopyCommand_Click"/>
                                        <Separator x:Name="SshEditSeparator"/>
                                        <MenuItem x:Name="SshEditItem" Header="_Edit..." Click="SshEditHost_Click"/>
                                        <MenuItem x:Name="SshDuplicateItem" Header="D_uplicate..." Click="SshDuplicateHost_Click"/>
                                        <MenuItem x:Name="SshDeleteItem" Header="_Delete..." Click="SshDeleteHost_Click"/>
                                        <Separator x:Name="SshGeneralSeparator"/>
                                        <MenuItem Header="_Add Host..." Click="SshAddHost_Click"/>
                                        <MenuItem Header="_Reload" Click="SshReload_Click"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="210" DisplayMemberBinding="{Binding DisplayName}">
                                            <GridViewColumnHeader Content="Host" Tag="Patterns" ToolTip="The name you connect with (ssh &lt;host&gt;); several names or patterns are allowed"/>
                                        </GridViewColumn>
                                        <GridViewColumn Width="160" DisplayMemberBinding="{Binding HostName}">
                                            <GridViewColumnHeader Content="Address" Tag="HostName" ToolTip="HostName: the real server name or IP address"/>
                                        </GridViewColumn>
                                        <GridViewColumn Width="110" DisplayMemberBinding="{Binding User}">
                                            <GridViewColumnHeader Content="User" Tag="User"/>
                                        </GridViewColumn>
                                        <GridViewColumn Width="70" DisplayMemberBinding="{Binding PortText}">
                                            <GridViewColumnHeader Content="Port" Tag="PortText"/>
                                        </GridViewColumn>
                                        <GridViewColumn Width="180" DisplayMemberBinding="{Binding IdentityFile}">
                                            <GridViewColumnHeader Content="Key file" Tag="IdentityFile" ToolTip="IdentityFile: the private key used to log in"/>
                                        </GridViewColumn>
                                        <GridViewColumn Width="130" DisplayMemberBinding="{Binding ProxyJump}">
                                            <GridViewColumnHeader Content="Jump host" Tag="ProxyJump" ToolTip="ProxyJump: connect through this host first"/>
                                        </GridViewColumn>
                                        <GridViewColumn Width="200">
                                            <GridViewColumnHeader Content="Other options" Tag="OtherOptionsText"/>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding OtherOptionsText}" ToolTip="{Binding OtherOptionsTooltip}"
                                                               Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <!-- No config file, or no hosts -->
                            <StackPanel
                                x:Name="SshEmptyPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="460"
                                Visibility="Collapsed">
                                <TextBlock Text="&#xE8D7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="36"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                                <TextBlock x:Name="SshEmptyTitle" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,4"/>
                                <TextBlock x:Name="SshEmptyText" Style="{StaticResource HintText}" TextAlignment="Center"/>
                                <StackPanel x:Name="SshMissingActions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                    <Button Content="Create Config File" Style="{StaticResource AccentButton}" Margin="0,0,8,0" Click="SshCreateFile_Click"/>
                                    <Button Content="Choose Existing File..." Margin="0" Click="SshChangeFile_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="KeysTab" Header="SSH Keys"
                         nav:PageInfo.Glyph="&#xE192;"
                         nav:PageInfo.Group="Tools"
                         nav:PageInfo.Subtitle="Your SSH key pairs. Right-click a key to copy its public key or add it to ssh-agent.">
                    <DockPanel Margin="0,4,0,0">
                        <!-- ssh-agent and actions -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="AgentButton" Content="Turn On ssh-agent" Margin="8,0,8,0" Visibility="Collapsed" Click="AgentEnable_Click"
                                            ToolTip="Start the ssh-agent service and start it automatically from now on (asks for admin rights)"/>
                                    <Button Content="Open Folder" Margin="0,0,8,0" Click="KeysOpenFolder_Click"/>
                                    <Button Content="Generate Key" Style="{StaticResource AccentButton}" Click="KeyGenerate_Click"/>
                                </StackPanel>
                                <Ellipse x:Name="AgentDot" Width="10" Height="10" Margin="0,0,12,0" VerticalAlignment="Center" Fill="{DynamicResource Brush.TextMuted}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="AgentText" FontWeight="SemiBold" Text="Checking ssh-agent..."/>
                                    <TextBlock x:Name="AgentHint" Style="{StaticResource HintText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock x:Name="KeysStatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Style="{StaticResource HintText}"/>

                        <Grid>
                            <ListView
                                x:Name="KeyList"
                                SelectionMode="Single"
                                PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown"
                                MouseDoubleClick="KeyList_MouseDoubleClick">
                                <ListView.ContextMenu>
                                    <ContextMenu x:Name="KeyMenu" Opened="KeyMenu_Opened">
                                        <MenuItem x:Name="KeyCopyItem" Header="_Copy Public Key" FontWeight="SemiBold" Click="KeyCopy_Click"/>
                                        <MenuItem x:Name="KeyAgentItem" Header="_Add to ssh-agent" Click="KeyAddToAgent_Click"/>
                                        <MenuItem x:Name="KeyCreatePublicItem" Header="Create _Public Key" Click="KeyCreatePublic_Click"/>
                                        <MenuItem x:Name="KeyShowItem" Header="_Show in Explorer" Click="KeyShow_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="KeyDeleteItem" Header="_Delete..." Click="KeyDelete_Click"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="300">
                                            <GridViewColumnHeader Content="Key"/>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel ToolTip="{Binding Problem}">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Problem}" FontSize="12" Foreground="{DynamicResource Brush.WarningText}"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Problem}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding TypeText}"/>
                                        <GridViewColumn Width="340">
                                            <GridViewColumnHeader Content="Fingerprint" ToolTip="Compare with the fingerprint a server or GitHub shows for the key"/>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Fingerprint}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                               Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Comment" Width="150" DisplayMemberBinding="{Binding Comment}"/>
                                        <GridViewColumn Width="80">
                                            <GridViewColumnHeader Content="ssh-agent"/>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AgentText}" Foreground="{DynamicResource Brush.Success}" FontWeight="SemiBold"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Created" Width="100" DisplayMemberBinding="{Binding CreatedText}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <StackPanel x:Name="KeysEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Visibility="Collapsed">
                                <TextBlock Text="&#xE192;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="36"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                                <TextBlock Text="No SSH keys yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                <TextBlock Style="{StaticResource HintText}" TextAlignment="Center"
                                           Text="Generate a key to log in to servers and GitHub without a password."/>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <!-- Busy indicator -->
            <DockPanel Grid.Row="3" Margin="0,8,0,0">
                <ProgressBar
                    x:Name="BusyProgress"
                    DockPanel.Dock="Right"
                    Width="140"
                    Height="12"
                    IsIndeterminate="True"
                    Visibility="Hidden"/>
                <TextBlock x:Name="BusyText" Foreground="{DynamicResource Brush.TextSecondary}" Text="Ready" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
