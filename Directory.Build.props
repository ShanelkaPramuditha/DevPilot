<Project>
  <!-- Settings shared by every project in the repository (app and tests). -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Code quality: every build runs the .NET analyzers and the code-style rules in .editorconfig.
    Findings are warnings while you work; the git hooks and CI build with
    -p:TreatWarningsAsErrors=true, so nothing with warnings gets committed or merged.
  -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required for the unused-using rule (IDE0005) to run during builds; the XML file is not shipped. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <!-- Missing or misplaced XML doc comments are not errors. -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1587</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Product>DevPilot</Product>
    <Authors>Shanelka Pramuditha</Authors>
    <Company>Shanelka Pramuditha</Company>
    <Copyright>Copyright © Shanelka Pramuditha 2026</Copyright>
    <!-- Release builds override this from the git tag (see .github/workflows/release.yml). -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <!-- Show "1.2.0" instead of "1.2.0+<commit hash>" in file properties. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
