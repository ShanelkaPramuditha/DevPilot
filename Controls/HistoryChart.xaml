<UserControl x:Class="DevPilot.Controls.HistoryChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Background="{DynamicResource Brush.Card}"
        BorderBrush="{DynamicResource Brush.CardStroke}"
        BorderThickness="1"
        CornerRadius="6"
        Padding="14,12">
        <DockPanel>
            <!-- Title and current value -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock
                    x:Name="CurrentText"
                    DockPanel.Dock="Right"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Brush.TextPrimary}"/>
                <TextBlock
                    x:Name="TitleText"
                    Foreground="{DynamicResource Brush.TextSecondary}"/>
            </DockPanel>

            <!-- Time axis -->
            <DockPanel DockPanel.Dock="Bottom" Margin="44,4,0,0">
                <TextBlock x:Name="NowLabel" DockPanel.Dock="Right" Text="now" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                <TextBlock x:Name="StartLabel" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Value axis labels (top, middle, bottom) -->
                <Grid Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock x:Name="MaxLabel" VerticalAlignment="Top" HorizontalAlignment="Right" FontSize="11" Margin="0,-7,0,0" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock x:Name="MidLabel" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock x:Name="MinLabel" VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="11" Margin="0,0,0,-7" Foreground="{DynamicResource Brush.TextMuted}"/>
                </Grid>

                <Canvas
                    x:Name="Plot"
                    Grid.Column="1"
                    MinHeight="110"
                    Background="Transparent"
                    ClipToBounds="False"
                    SizeChanged="Plot_SizeChanged"
                    MouseMove="Plot_MouseMove"
                    MouseLeave="Plot_MouseLeave">
                    <Line x:Name="GridTop" Stroke="{DynamicResource Brush.CardStroke}" StrokeThickness="1"/>
                    <Line x:Name="GridMid" Stroke="{DynamicResource Brush.CardStroke}" StrokeThickness="1" StrokeDashArray="3 3"/>
                    <Line x:Name="GridBottom" Stroke="{DynamicResource Brush.CardStroke}" StrokeThickness="1"/>
                    <Polygon x:Name="Area" Fill="{DynamicResource Brush.Accent}" Opacity="0.14"/>
                    <Polyline x:Name="Series" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2" StrokeLineJoin="Round"/>
                    <Line x:Name="Crosshair" Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1" Visibility="Collapsed"/>
                    <Ellipse
                        x:Name="Dot"
                        Width="10"
                        Height="10"
                        Fill="{DynamicResource Brush.Accent}"
                        Stroke="{DynamicResource Brush.Card}"
                        StrokeThickness="2"
                        Visibility="Collapsed"/>
                    <Border
                        x:Name="Readout"
                        Background="{DynamicResource Brush.Card}"
                        BorderBrush="{DynamicResource Brush.CardStroke}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,4"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                        <StackPanel>
                            <TextBlock x:Name="ReadoutValue" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                            <TextBlock x:Name="ReadoutTime" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock
                        x:Name="EmptyText"
                        Text="Collecting data..."
                        Foreground="{DynamicResource Brush.TextMuted}"/>
                </Canvas>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
